@model OnlineBankLoanPortal.ViewModels.RepaymentVM

<div class="container">

    <h2>Upload Payment Receipt</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @* <input type="hidden" name="applicationId" value="@Model.LoanApplicationId" /> *@
        <input type="hidden" asp-for="LoanApplicationId" />
        <div class="form-group">
            <label asp-for="AmountPaid"></label>
            <input asp-for="AmountPaid" class="form-control" />
            <span asp-validation-for="AmountPaid" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="PaymentDate"></label>
            <input asp-for="PaymentDate" class="form-control" type="date" value="201-06-01" id="date-picker" />
            <span asp-validation-for="PaymentDate" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Receipt"></label>
            <input asp-for="Receipt" type="file" class="form-control" />
            <span asp-validation-for="Receipt" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Submit Payment</button>
    </form>

    <a asp-action="Index" asp-controller="LoanApplication" class="btn btn-secondary">Back to Loan Applications</a>

</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('date-picker').value = new Date();
    </script>
}