@using OnlineBankLoanPortal.Repository
@model IEnumerable<Repayment>

<div class="container">
    <h2>Repayments</h2>

    @* <form method="get" asp-action="Index">
        <label for="applicationId">Filter by Loan Application ID:</label>
        <div class="row">
            <div class="col-4">
                <div class="form-group">
                    <input type="number" name="applicationId" class="form-control" min="0" />
                </div>
            </div>
            <div class="col-2">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </div>
    </form> *@

    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Application Type</th>
                <th>Amount</th>
                <th>Payment Date</th>
                <th>Receipt</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count(); i++)
            {
                var repayment = Model.ElementAt(i);
                <tr>
                    <td>@(i + 1)</td>
                    <td>@repayment.Application?.Product?.ProductName</td>
                    <td>@repayment.AmountPaid</td>
                    <td>@repayment.PaymentDate.ToShortDateString()</td>
                    <td>
                        @if (!string.IsNullOrEmpty(repayment.ReceiptUpload))
                        {
                            <a href="@Url.Content("~/" + repayment.ReceiptUpload)" target="_blank">View Receipt</a>
                        }
                        else
                        {
                            <span>No Receipt</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>