@model OnlineBankLoanPortal.Models.LoanApplication
@{
    ViewData["Title"] = "Track Repayments";
}

<h1>@ViewData["Title"]</h1>

<h4>Loan Details</h4>
<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.LoanType)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.LoanType.LoanTypeName)
    </dd>
    <dt class="col-sm-2">
        Customer Name
    </dt>
    <dd class="col-sm-10">
        @Model.Customer.FullName
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.AmountRequested)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.AmountRequested)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.InterestRate)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.InterestRate)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.RepaymentTermMonths)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.RepaymentTermMonths)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.MonthlyPayment)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.MonthlyPayment)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.LastRepaymentDate)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.LastRepaymentDate)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.OutstandingBalance)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.OutstandingBalance)
    </dd>
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Status)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Status)
    </dd>
</dl>

<form asp-action="ProcessRepayment" method="post">
    <input type="hidden" asp-for="LoanApplicationId" />
    <div class="form-group">
        <label for="paymentAmount">Payment Amount:</label>
        <input type="number" class="form-control" id="paymentAmount" name="paymentAmount" required />
    </div>
    <button type="submit" class="btn btn-sm btn-primary">Process Payment</button>
    <a asp-action="LoanApplications" class="btn btn-sm btn-secondary">Back to List</a>
</form>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger mt-3">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}