@model OnlineBankLoanPortal.Models.RepaymentTerm
@{
    ViewData["Title"] = "Edit Repayment Term";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="EditRepaymentTerm">
    <input type="hidden" asp-for="RepaymentTermId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="LoanTypeId" class="control-label"></label>
        <select asp-for="LoanTypeId" class="form-control" asp-items="ViewBag.LoanTypeId"></select>
        <span asp-validation-for="LoanTypeId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TermInMonths" class="control-label"></label>
        <input asp-for="TermInMonths" class="form-control" />
        <span asp-validation-for="TermInMonths" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <label class="form-check-label">
            <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
        </label>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="RepaymentTerms" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
