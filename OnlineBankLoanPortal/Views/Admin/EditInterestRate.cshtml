@model OnlineBankLoanPortal.Models.InterestRate
@{
    ViewData["Title"] = "Edit Interest Rate";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="EditInterestRate">
    <input type="hidden" asp-for="InterestRateId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="LoanTypeId" class="control-label"></label>
        <select asp-for="LoanTypeId" class="form-control" asp-items="ViewBag.LoanTypeId"></select>
        <span asp-validation-for="LoanTypeId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Rate" class="control-label"></label>
        <input asp-for="Rate" class="form-control" />
        <span asp-validation-for="Rate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EffectiveDate" class="control-label"></label>
        <input asp-for="EffectiveDate" class="form-control" />
        <span asp-validation-for="EffectiveDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="EndDate" class="control-label"></label>
        <input asp-for="EndDate" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="InterestRates" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}