@model OnlineBankLoanPortal.Models.LoanType
@{
    ViewData["Title"] = "Delete Loan Type";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Loan Type</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.LoanTypeName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LoanTypeName)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.IsActive)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.IsActive)</dd>
    </dl>

    <form asp-action="DeleteLoanType" asp-route-id="@Model.LoanTypeId">
        <input type="hidden" asp-for="LoanTypeId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="LoanTypes" class="btn btn-secondary">Back to List</a>
    </form>
</div>