@model OnlineBankLoanPortal.Models.RepaymentTerm
@{
    ViewData["Title"] = "Delete Repayment Term";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Repayment Term</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.LoanType)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LoanType.LoanTypeName)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TermInMonths)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TermInMonths)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.IsActive)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.IsActive)</dd>
    </dl>

    <form asp-action="DeleteRepaymentTerm" asp-route-id="@Model.RepaymentTermId">
        <input type="hidden" asp-for="RepaymentTermId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="RepaymentTerms" class="btn btn-secondary">Back to List</a>
    </form>
</div>