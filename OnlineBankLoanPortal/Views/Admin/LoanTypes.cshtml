@model IEnumerable<OnlineBankLoanPortal.Models.LoanType>
@{
    ViewData["Title"] = "Loan Types";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="CreateLoanType" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.LoanTypeName)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.IsActive)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.LoanTypeName)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                <td>
                    <a asp-action="EditLoanType" asp-route-id="@item.LoanTypeId" class="btn btn-sm btn-primary">Edit</a> |
                    <a asp-action="DeleteLoanType" asp-route-id="@item.LoanTypeId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>