@using OnlineBankLoanPortal.ViewModels
@model IEnumerable<LoanApplicationVM>


<div class="container">
    <h2>Loan Applications</h2>
    <a class="btn btn-outline-primary" asp-action="Create">Add New Application</a>
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Applicant Name</th>
                <th>Product Name</th>
                <th>Amount Requested</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count(); i++)
            {
                var application = Model.ElementAt(i);
                <tr>
                    <td>@(i + 1)</td>
                    <td>@application.ApplicantName</td>
                    <td>@application.ProductName</td>
                    <td>@application.AmountRequested</td>
                    <td>@application.Status</td>
                    <td>
                        <a asp-action="Create" asp-route-applicationId="@application.Id" asp-controller="Repayment" class="btn btn-primary">Upload Receipt</a>
                        <a asp-action="Edit" asp-route-id="@application.Id" class="btn btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@application.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this application?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>