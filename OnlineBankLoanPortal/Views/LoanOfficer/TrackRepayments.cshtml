@model OnlineBankLoanPortal.ViewModels.LoanApplicationVM
@{
    ViewData["Title"] = "Track Repayments";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Loan Application Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => nameof(LoanType))
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LoanTypeName)
        </dd>
        <dt class="col-sm-2">
            Customer Name
        </dt>
        <dd class="col-sm-10">
            @* Display Customer Name Here *@
            @Html.DisplayFor(model => model.CustomerName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AmountRequested)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AmountRequested)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ExpectedDisbursementDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ExpectedDisbursementDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ActualDisbursementDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ActualDisbursementDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.InterestRate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.InterestRate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.RepaymentTermMonths)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.RepaymentTermMonths)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MonthlyPayment)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MonthlyPayment)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LastRepaymentDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastRepaymentDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OutstandingBalance)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OutstandingBalance)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
</div>

<form asp-action="ProcessRepayment">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label for="paymentAmount">Payment Amount:</label>
        <input type="number" class="form-control" id="paymentAmount" name="paymentAmount" required />
    </div>
    <button type="submit" class="btn btn-primary">Process Payment</button>
    <a asp-action="LoanApplications" class="btn btn-secondary">Back to List</a>
</form>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger mt-3">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}