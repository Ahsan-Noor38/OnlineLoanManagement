@model OnlineBankLoanPortal.Models.LoanApplication

@{
    ViewData["Title"] = "Loan Application Documents";
}

<div class="container">

    <h1>@ViewData["Title"]</h1>

    <div>
        <h4>Loan Application Details</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">
                Loan ID:
            </dt>
            <dd class="col-sm-10">
                @Model.LoanApplicationId
            </dd>
            <dt class="col-sm-2">
                Customer Name:
            </dt>
            <dd class="col-sm-10">
                @Model.Customer.FullName
            </dd>
            <dt class="col-sm-2">
                Loan Type
            </dt>
            <dd class="col-sm-10">
                @Model.LoanType.LoanTypeName
            </dd>
        </dl>
    </div>

    @if (ViewBag.NoDocuments != null)
    {
        <div class="alert alert-info">
            @ViewBag.NoDocuments
        </div>
    }
    else
    {
        <h3>Uploaded Documents</h3>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Document Name</th>
                    <th>View</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var document in Model.LoanApplicationDocuments)
                {
                    <tr>
                        <td>@document.DocumentType</td>
                        <td><a href="@document.FilePath" target="_blank">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="LoanApplications" class="btn btn-sm btn-secondary">Back to Applications</a>
</div>
